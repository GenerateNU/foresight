# Application
APP_NAME=Foresight
DEBUG=false

# Database
# App traffic. Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
# On Neon, `neon deploy` / `neon env pull` writes the pooled (-pooler) URL here in
# libpq form (postgresql://...?sslmode=require&channel_binding=require); config.py
# normalizes it for asyncpg, so paste it as-is.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
# Direct (non-pooled) URL used only by Alembic migrations. Leave empty to reuse
# DATABASE_URL (fine for local Docker Postgres; required on Neon).
DATABASE_URL_UNPOOLED=

# External event sources
PREDICTHQ_TOKEN=

# Hotel CSV uploads: most files in one upload, and the largest file in MB. A
# bigger upload is refused with 413. Parsed files wait in memory for their job.
UPLOAD_MAX_FILES=10
UPLOAD_MAX_FILE_MB=50

# Sign in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" on the Google OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Where the browser lands after sign-in, and the only origin allowed to send the
# session cookie. An origin only (scheme, host, port), no path.
FRONTEND_URL=http://localhost:5173
# Signs the session cookie. Generate with `openssl rand -hex 32`. Changing it
# signs everyone out. Sign-in answers 503 until it is set.
SESSION_SECRET=
# A session ends this long after the user's last request (default: 14 days).
SESSION_MAX_AGE_SECONDS=1209600
# The cookie is HTTPS-only unless this is false. False is for plain-http local
# dev only; leave it true (the default) in production.
SESSION_COOKIE_SECURE=false
# lax: the frontend and API share a site (localhost, or subdomains of one
# domain). none: they don't; needs SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SAMESITE=lax
