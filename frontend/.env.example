# Where the backend API lives (FastAPI). Copy this file to .env.local to change it.
VITE_API_URL=http://localhost:8000
# No login yet, so the app reads one hotel. Swap for the signed-in user's hotel once auth lands.
VITE_HOTEL_ID=1
# true = serve fake responses from src/api/mocks, so screens work without the backend.
VITE_USE_MOCKS=false
