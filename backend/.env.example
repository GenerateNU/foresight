# backend/.env — optional local overrides.
#
# Settings load order (later wins): repo-root ../.env, then this backend/.env.
# Use this file only for values you want to differ from the repo-root .env when
# running the backend directly from ./backend (e.g. uvicorn, alembic, pytest).
# Leave it absent if you don't need overrides.

# Database (override the root .env / in-container default for local runs)
# DATABASE_URL=postgresql+asyncpg://foresight:foresight@localhost:5432/foresight_db

# External event sources
# PREDICTHQ_TOKEN=
# ASKNEWS_CLIENT_ID=
# ASKNEWS_CLIENT_SECRET=

# External APIs
# XRAPIDAPI_KEY=
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
